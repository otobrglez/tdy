# EditorConfig: https://editorconfig.org

root = true

[*]
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.rs]
max_line_length = 100

[*.md]
# Two trailing spaces denote a line break in Markdown.
trim_trailing_whitespace = false

[*.{yml,yaml,nix}]
indent_size = 2
